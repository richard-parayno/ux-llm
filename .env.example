# ---------------------------------------------------------------------------
# intavue configuration. Copy to .env and fill in what you need.
# With no keys at all the app runs in offline demo mode (heuristic mock).
# ---------------------------------------------------------------------------

# Claude (reflection, live nudges, refinements)
ANTHROPIC_API_KEY=
# claude | mock — empty = claude when a key is present, otherwise mock
INTAVUE_LLM_PROVIDER=
INTAVUE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
INTAVUE_EFFORT=high
# Optional faster model for live nudges (defaults to INTAVUE_MODEL at low effort)
INTAVUE_LIVE_MODEL=

# Deepgram (audio upload + live transcription)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Storage (libSQL URL: file:… locally, or libsql://… for Turso)
DATABASE_URL=file:data/intavue.db

# Production server (node server.js)
PORT=3000
# Public URL of the app, e.g. https://intavue.example.org — needed for form
# submissions when running behind a proxy that doesn't send X-Forwarded-* headers.
ORIGIN=
# Max upload size for recordings
BODY_SIZE_LIMIT=1G
